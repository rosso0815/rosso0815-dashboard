package admin

import "sort"

func sortedErrorMessages(errors map[string]string) []string {
	if len(errors) == 0 {
		return nil
	}
	keys := make([]string, 0, len(errors))
	for k := range errors {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	messages := make([]string, 0, len(keys))
	for _, k := range keys {
		messages = append(messages, errors[k])
	}
	return messages
}

func formMethod(method string) string {
	if method == "" {
		return "post"
	}
	return method
}

func fieldInputClass(hasErr bool) string {
	if hasErr {
		return "form-control is-invalid"
	}
	return "form-control"
}

func fieldType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}

templ ResourceForm(config FormConfig) {
	<section>
		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h2 mb-0">{ config.Title }</h1>
		</div>
		if len(config.Errors) > 0 {
			<div class="alert alert-danger" role="alert">
				for _, message := range sortedErrorMessages(config.Errors) {
					<div>{ message }</div>
				}
			</div>
		}
		<form class="col-12 col-xl-8" method={ formMethod(config.Method) } action={ templ.SafeURL(config.Action) }>
			for _, field := range config.Fields {
				<div class="mb-3">
					<label class="form-label" for={ field.Name }>{ field.Label }</label>
					<input
						class={ fieldInputClass(config.Errors[field.Name] != "") }
						type={ fieldType(field.Type) }
						id={ field.Name }
						name={ field.Name }
						value={ field.Value }
						placeholder={ field.Placeholder }
						required?={ field.Required }
						aria-invalid?={ config.Errors[field.Name] != "" }
					/>
					if config.Errors[field.Name] != "" {
						<div class="invalid-feedback">{ config.Errors[field.Name] }</div>
					}
				</div>
			}
			<div class="d-flex gap-2">
				<button class="btn btn-primary" type="submit">
					if config.SubmitLabel == "" {
						Save
					} else {
						{ config.SubmitLabel }
					}
				</button>
				if config.CancelHref != "" {
					<a class="btn btn-outline-secondary" href={ templ.SafeURL(config.CancelHref) }>Cancel</a>
				}
			</div>
		</form>
	</section>
}
