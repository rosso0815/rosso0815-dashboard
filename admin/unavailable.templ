package admin

func unavailableTitle(title string) string {
	if title == "" {
		return "Entry Unavailable"
	}
	return title
}

func unavailableMessage(message string) string {
	if message == "" {
		return "The requested entry could not be found or is no longer available."
	}
	return message
}

func unavailableBackLabel(label string) string {
	if label == "" {
		return "Back"
	}
	return label
}

templ Unavailable(config UnavailableConfig) {
	<section>
		<div class="d-flex align-items-center justify-content-between mb-3">
			<h1 class="h2 mb-0">{ unavailableTitle(config.Title) }</h1>
		</div>
		<div class="card p-4">
			<p class="mb-3 text-secondary">{ unavailableMessage(config.Message) }</p>
			if config.BackHref != "" {
				<div>
					<a class="btn btn-outline-secondary" href={ templ.SafeURL(config.BackHref) }>{ unavailableBackLabel(config.BackLabel) }</a>
				</div>
			}
		</div>
	</section>
}
