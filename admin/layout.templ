package admin

templ navLinks(nav []NavItem, currentPath string) {
	<nav class="nav nav-pills flex-column" aria-label="Admin navigation">
		for _, item := range nav {
			if item.Href == currentPath {
				<a class="nav-link active mb-1" href={ templ.SafeURL(item.Href) } aria-current="page">{ item.Label }</a>
			} else {
				<a class="nav-link text-dark mb-1" href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
			}
		}
	</nav>
}

templ Layout(title string, nav []NavItem, currentPath string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
			<title>{ title }</title>
		</head>
		<body class="bg-light">
			<div class="container-fluid p-0">
				<div class="row g-0 min-vh-100">
					<aside class="col-12 col-md-3 col-lg-2 bg-white border-end text-dark p-3">
						<div class="d-none d-md-block">
							<a class="d-block mb-4 fw-bold text-dark text-decoration-none" href="/">Admin Dashboard</a>
							@navLinks(nav, currentPath)
						</div>
						<details class="d-md-none">
							<summary class="d-flex align-items-center justify-content-between fw-bold text-dark list-unstyled" style="cursor: pointer;">
								<span>Admin Dashboard</span>
								<span class="btn btn-outline-secondary btn-sm">Menu</span>
							</summary>
							<div class="pt-3">
								@navLinks(nav, currentPath)
							</div>
						</details>
					</aside>
					<main class="col-12 col-md-9 col-lg-10 bg-light">
						<div class="container-fluid px-3 px-md-4 py-4">
							@content
						</div>
					</main>
				</div>
			</div>
		</body>
	</html>
}
