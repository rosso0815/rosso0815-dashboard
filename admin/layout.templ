package admin

templ Layout(title string, nav []NavItem, currentPath string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
			<title>{ title }</title>
		</head>
		<body class="bg-light">
			<div class="container-fluid p-0">
				<div class="row g-0 min-vh-100">
					<aside class="col-auto col-md-3 col-lg-2 bg-light text-black p-2 p-md-3">
						<a class="d-none d-md-block mb-4 fw-bold text-white text-decoration-none" href="/">Admin Dashboard</a>
						<a class="d-md-none mb-4 fw-bold text-white text-decoration-none" href="/" aria-label="Admin Dashboard">A</a>
						<nav class="nav nav-pills flex-column" aria-label="Admin navigation">
						for _, item := range nav {
							if item.Href == currentPath {
								<a class="nav-link active mb-1" href={ templ.SafeURL(item.Href) } aria-current="page">{ item.Label } 1</a>
							} else {
								<a class="nav-link text-black mb-1" href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
							}
						}
						</nav>
					</aside>
					<main class="col bg-light min-vh-100">
						<div class="container-fluid px-3 px-md-4 py-4">
							@content
						</div>
					</main>
				</div>
			</div>
		</body>
	</html>
}
